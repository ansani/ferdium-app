{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferdium",
  "version": "7.1.3",
  "identifier": "org.ferdium.ferdium-app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://127.0.0.1:8080",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "node esbuild.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ferdium",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 500,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "focus": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https: wss:; font-src 'self' data:"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "category": "Utility",
    "shortDescription": "Messaging app for all your services"
  }
}
